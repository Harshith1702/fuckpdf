{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @pdf-editor/web build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://boringpdf.app",
      "permanent": false
    }
  ]
}
